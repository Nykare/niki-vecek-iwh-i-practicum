# Copy this file to .env and fill in your own values. .env is gitignored — never commit real tokens.

# Private app access token from Settings > Integrations > Private Apps
# Scopes required: crm.schemas.custom.read, crm.schemas.custom.write,
# crm.objects.custom.read, crm.objects.custom.write,
# crm.objects.contacts.read, crm.objects.contacts.write
PRIVATE_APP_ACCESS=

# The custom object's fully-qualified name or objectTypeId (e.g. "books" or "2-12345678").
# Find it in Settings > Data Management > Objects > Books, in the object's URL/settings,
# or via GET https://api.hubapi.com/crm/v3/schemas
CUSTOM_OBJECT_TYPE=books
